TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MIN_SCORE=8
VIRAL_THRESHOLD=7

# Optional comma-separated HTTPS JSON feeds that you are allowed to read.
# Each entry must return either a list of provider items or {"items": [...]}.
# Item fields: id, source, url, author, text, created_at
DEAL_ALERT_JSON_FEED_URLS=
DEAL_ALERT_RSS_FEED_URLS=

# X/Threads public read/search providers are disabled by default because v1
# only uses free, official, terms-compliant access.
ENABLE_X_PROVIDER=false
ENABLE_THREADS_PROVIDER=false
